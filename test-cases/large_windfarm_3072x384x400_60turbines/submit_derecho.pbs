#!/usr/bin/env bash

# Derecho PBS job script for the 3072 x 384 x 400 / 60-turbine CPU case.
#
# Compile first:
#   ./compile_derecho.sh cpu
#
# Submit the default 16-rank CPU smoke run from this directory:
#   qsub submit_derecho.pbs
#
# Submit the same CPU run explicitly:
#   qsub -N lesgo_wf60_cpu16 -v RUN_PROFILE=cpu,RUN_LABEL=cpu16 \
#        -q develop -l select=2:ncpus=8:mpiprocs=8:mem=180gb \
#        -l place=scatter:shared submit_derecho.pbs
#
# For larger CPU baselines, edit `nproc` in `lesgo.conf` and keep the qsub
# `select * mpiprocs`, `MPI_RANKS`, and `MPI_PPN` values consistent.
#
# This file does not compile the code. It only cleans old outputs and runs the
# already-built profile executable.

# Change this account to your Derecho allocation.
#PBS -A ujhb0028
#PBS -N lesgo_wf60_cpu16
#PBS -q develop

# Resource sizing. Keep these four items consistent:
#   1. the PBS select line below;
#   2. MPI_RANKS below;
#   3. MPI_PPN below;
#   4. nproc in lesgo.conf.
#
# Current layout: 16 CPU MPI ranks across two shared CPU nodes.
#   select=2   -> reserve resources on 2 nodes
#   mpiprocs=8 -> run 8 MPI ranks per node
#   ncpus=8    -> reserve 8 CPU cores per node
#
# Total MPI ranks = select * mpiprocs = 16.
# MPI_PPN below must equal mpiprocs.
#
# Example: 8 CPU ranks on one node:
#   #PBS -l select=1:ncpus=8:mpiprocs=8:mem=180gb
#   MPI_RANKS=8
#   MPI_PPN=8
#   nproc=8 in lesgo.conf
#
# On another cluster, translate select/mpiprocs/ncpus/mem to that scheduler's
# node/task syntax. Keep total MPI ranks equal to nproc in lesgo.conf.
#PBS -l select=2:ncpus=8:mpiprocs=8:mem=180gb
#PBS -l walltime=00:20:00
#PBS -l place=scatter:shared
#PBS -j oe

# Bash safety options:
#   -e: stop if any command fails.
#   -u: stop if an undefined variable is used.
#   -o pipefail: stop if any command inside a pipeline fails.
set -euo pipefail

cd "${PBS_O_WORKDIR}"

# Must match the PBS line and lesgo.conf nproc.
MPI_RANKS="${MPI_RANKS:-16}"
MPI_PPN="${MPI_PPN:-8}"
RUN_PROFILE="${RUN_PROFILE:-cpu}"
RUN_LABEL="${RUN_LABEL:-${RUN_PROFILE}}"
ARCHIVE_ROOT="${ARCHIVE_ROOT:-run-archives}"

case "${RUN_PROFILE}" in
  gpu)
    RUN_EXE=./lesgo-run-exe-gpu
    ;;
  cpu)
    RUN_EXE=./lesgo-run-exe-cpu
    ;;
  *)
    echo "ERROR: RUN_PROFILE must be gpu or cpu, got ${RUN_PROFILE}" >&2
    exit 2
    ;;
esac

# Runtime module stack. Keep this consistent with compile_derecho.sh.
# On another cluster, replace this with that site's runtime modules.
module reset
if [[ "${RUN_PROFILE}" == "gpu" ]]; then
  module load nvhpc/25.9 cuda/12.9.0 cray-mpich/8.1.32 fftw/3.3.10
  export MPICH_GPU_SUPPORT_ENABLED=1
  export MPICH_GPU_MANAGED_MEMORY_SUPPORT_ENABLED=1
else
  module load nvhpc/25.9 cray-mpich/8.1.32 fftw/3.3.10
  unset MPICH_GPU_SUPPORT_ENABLED
  unset MPICH_GPU_MANAGED_MEMORY_SUPPORT_ENABLED
fi

if [[ ! -x "${RUN_EXE}" ]]; then
  echo "ERROR: ${RUN_EXE} is missing. Run ./compile_derecho.sh ${RUN_PROFILE} first." >&2
  exit 2
fi

# Clean output from older runs.
rm -rf output turbineOutput
rm -f total_time.dat check_ke.out grid.out vel.out.c* tavg.out.c* lesgo_param.out

echo "Running 60-turbine wind-farm ${RUN_PROFILE} case on Derecho"
date

# Derecho provides set_gpu_rank to bind each MPI rank to one GPU.
# On another cluster, replace this with the recommended mpiexec/srun command.
LOG_FILE="lesgo_${RUN_LABEL}.log"
set +e
if [[ "${RUN_PROFILE}" == "gpu" ]] && command -v set_gpu_rank >/dev/null 2>&1; then
  mpiexec -n "${MPI_RANKS}" -ppn "${MPI_PPN}" set_gpu_rank "${RUN_EXE}" 2>&1 | tee "${LOG_FILE}"
  MPI_STATUS=${PIPESTATUS[0]}
else
  mpiexec -n "${MPI_RANKS}" -ppn "${MPI_PPN}" "${RUN_EXE}" 2>&1 | tee "${LOG_FILE}"
  MPI_STATUS=${PIPESTATUS[0]}
fi
set -e
echo "MPI_EXIT_STATUS=${MPI_STATUS}" | tee -a "${LOG_FILE}"

ARCHIVE_DIR="${ARCHIVE_ROOT}/${RUN_LABEL}"
rm -rf "${ARCHIVE_DIR}"
mkdir -p "${ARCHIVE_DIR}"
for item in "${LOG_FILE}" output turbineOutput total_time.dat check_ke.out grid.out lesgo_param.out; do
  if [[ -e "${item}" ]]; then
    cp -a "${item}" "${ARCHIVE_DIR}/"
  fi
done
shopt -s nullglob
for item in vel.out.c* tavg.out.c*; do
  cp -a "${item}" "${ARCHIVE_DIR}/"
done
shopt -u nullglob
echo "Archived run evidence to ${ARCHIVE_DIR}"

if [[ "${MPI_STATUS}" -ne 0 ]]; then
  echo "ERROR: LESGO exited with status ${MPI_STATUS}" >&2
  exit "${MPI_STATUS}"
fi

date
echo "Simulation finished"
