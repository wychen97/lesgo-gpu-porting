# Large-windfarm benchmark staging artifacts.  Keep the canonical README and
# tracked case inputs, but do not commit per-cluster job files, local monitors,
# binaries, or submitted-job records from exploratory runs.
/test-cases/large_windfarm_3072x384x400_60turbines/README_DERECHO_READY_*.md
/test-cases/large_windfarm_3072x384x400_60turbines/cpu_scaling_jobs/
/test-cases/large_windfarm_3072x384x400_60turbines/job_cpu80_*.pbs
/test-cases/large_windfarm_3072x384x400_60turbines/job_gpu8_*_mem*.pbs
/test-cases/large_windfarm_3072x384x400_60turbines/job_status_monitor/
